* text=auto
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.svg text eol=lf
*.png binary
*.ico binary

# Preserve bytes recorded by video source and historical evidence manifests.
/marketing/video/production/src/** -text whitespace=cr-at-eol
/marketing/video/production/evidence/** -text whitespace=cr-at-eol
/marketing/video/production/media/** -text whitespace=cr-at-eol
/marketing/video/production/package-lock.json -text whitespace=cr-at-eol
/marketing/video/production/public/brand/** -text whitespace=cr-at-eol
/marketing/video/release/2026-10-19/*.json -text whitespace=cr-at-eol
/marketing/video/release/2026-10-19/SHA256SUMS.txt -text whitespace=cr-at-eol
